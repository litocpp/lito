export namespace lito::toolchain
{

auto append_clang_attribute_queries(Vec<frontend::preprocessor::BuiltinQueryKey>& queries) -> void {
    namespace pp = frontend::preprocessor;
    for (const auto& spelling : CLANG_ATTRIBUTE_SPELLINGS) {
        if ((spelling.syntaxes & 2) != 0)
            queries.push(pp::BuiltinQueryKey::make<pp::HasCppAttributeQuery>(spelling.name));
    }
    queries.push(pp::BuiltinQueryKey::make<pp::HasCppAttributeQuery>("omp::directive"_str));
    queries.push(pp::BuiltinQueryKey::make<pp::HasCppAttributeQuery>("omp::sequence"_str));
    for (const auto& spelling : CLANG_ATTRIBUTE_SPELLINGS) {
        if ((spelling.syntaxes & 1) != 0)
            queries.push(pp::BuiltinQueryKey::make<pp::HasAttributeQuery>(spelling.name));
    }
    for (const auto& spelling : CLANG_ATTRIBUTE_SPELLINGS) {
        if ((spelling.syntaxes & 8) != 0)
            queries.push(pp::BuiltinQueryKey::make<pp::HasDeclspecAttributeQuery>(spelling.name));
    }
}

auto clang_attribute_known(frontend::AttributeSyntax syntax, ref<str> scope, ref<str> name)
    -> bool {
    namespace pp = frontend::preprocessor;
    auto full    = String::make(scope);
    if (! scope.is_empty()) full.push_str("::"_str);
    full.push_str(name);
    auto normalized = pp::CppAttributeBuiltinQueryHandler::normalize(full.as_str());
    auto mask       = syntax == frontend::AttributeSyntax::Gnu        ? 1u
                      : syntax == frontend::AttributeSyntax::Declspec ? 8u
                                                                      : 6u;
    // OpenMP directive attributes are parsed outside the generated attribute table.
    if (syntax == frontend::AttributeSyntax::Cpp &&
        (normalized == "omp::directive"_str || normalized == "omp::sequence"_str))
        return true;
    for (const auto& spelling : CLANG_ATTRIBUTE_SPELLINGS) {
        if (spelling.name == normalized.as_str() && (spelling.syntaxes & mask) != 0) return true;
    }
    return false;
}

auto clang_attribute_warnings(slice<frontend::AttributeUse>      attributes,
                              slice<String>                      plugin_scopes,
                              const compiler::DiagnosticOptions& diagnostics) -> Vec<String> {
    auto warnings = Vec<String>::make();
    for (const auto& warning : diagnostics.warnings) {
        if (warning.warning == compiler::CompilerWarning::UnknownAttributes && ! warning.enabled)
            return warnings;
    }
    for (const auto& attribute : attributes) {
        if (attribute.scope.is_empty() &&
            (attribute.name == "unsafe"_str || attribute.name == "__unsafe__"_str))
            continue;
        auto provided = false;
        for (const auto& scope : plugin_scopes) {
            if (attribute.scope == scope.as_str()) provided = true;
        }
        if (provided || clang_attribute_known(
                            attribute.syntax, attribute.scope.as_str(), attribute.name.as_str()))
            continue;
        auto name = attribute.scope.clone();
        if (! name.is_empty()) name.push_str("::"_str);
        name.push_str(attribute.name.as_str());
        warnings.push(
            rstd::format("{}:{}:{}: warning: unknown attribute '{}' ignored [-Wunknown-attributes]",
                         attribute.location.path.as_path(),
                         attribute.location.line,
                         attribute.column,
                         name.as_str()));
    }
    return warnings;
}

} // namespace lito::toolchain
