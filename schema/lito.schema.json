{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://raw.githubusercontent.com/litocpp/lito/main/schema/lito.schema.json",
  "title": "Lito manifest",
  "description": "Structural contract for lito.toml. Lito remains authoritative for filesystem, workspace graph, source discovery, and toolchain-dependent validation.",
  "oneOf": [
    {
      "$ref": "#/definitions/workspaceManifest"
    },
    {
      "$ref": "#/definitions/packageManifest"
    }
  ],
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/nonEmptyString"
      }
    },
    "relativePath": {
      "description": "A non-empty path relative to the manifest directory. Lito validates platform-specific path semantics.",
      "type": "string",
      "minLength": 1
    },
    "pathArray": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    },
    "nonEmptyPathArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    },
    "packageName": {
      "description": "An ASCII package name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "moduleName": {
      "description": "A dot-separated C++ module name.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "artifactName": {
      "description": "A safe artifact basename.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "packageVersion": {
      "oneOf": [
        {
          "$ref": "#/definitions/nonEmptyString"
        },
        {
          "type": "object",
          "required": [
            "workspace"
          ],
          "properties": {
            "workspace": {
              "enum": [
                true
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "packageLanguage": {
      "enum": ["c", "cpp"]
    },
    "languageStandard": {
      "enum": ["c99", "c11", "c17", "c23", "c++20", "c++23", "c++26"]
    },
    "packageLicense": {
      "oneOf": [
        {
          "$ref": "#/definitions/nonEmptyString"
        },
        {
          "type": "object",
          "required": [
            "workspace"
          ],
          "properties": {
            "workspace": {
              "enum": [
                true
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "predicateFamily": {
      "enum": [
        "unix",
        "windows",
        "unknown"
      ]
    },
    "predicateOs": {
      "enum": [
        "linux",
        "windows",
        "macos",
        "android",
        "freebsd",
        "netbsd",
        "openbsd",
        "unknown"
      ]
    },
    "familyPredicate": {
      "oneOf": [
        {
          "$ref": "#/definitions/predicateFamily"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/predicateFamily"
          }
        }
      ]
    },
    "osPredicate": {
      "oneOf": [
        {
          "$ref": "#/definitions/predicateOs"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/predicateOs"
          }
        }
      ]
    },
    "targetPredicate": {
      "type": "object",
      "properties": {
        "family": {
          "$ref": "#/definitions/familyPredicate"
        },
        "os": {
          "$ref": "#/definitions/osPredicate"
        },
        "not-family": {
          "$ref": "#/definitions/familyPredicate"
        },
        "not-os": {
          "$ref": "#/definitions/osPredicate"
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "version": {
          "$ref": "#/definitions/packageVersion"
        },
        "license": {
          "$ref": "#/definitions/packageLicense"
        },
        "source-root": {
          "description": "Source and usage path base, relative to the package manifest directory. It must contain the package directory.",
          "$ref": "#/definitions/relativePath"
        },
        "target": {
          "$ref": "#/definitions/targetPredicate"
        },
        "language": {
          "$ref": "#/definitions/packageLanguage"
        },
        "minimum-standard": {
          "$ref": "#/definitions/languageStandard"
        }
      },
      "additionalProperties": false
    },
    "explicitSources": {
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "$ref": "#/definitions/nonEmptyPathArray"
        }
      }
    },
    "targetSources": {
      "oneOf": [
        {
          "$ref": "#/definitions/explicitSources"
        },
        {
          "not": { "required": ["sources"] }
        }
      ]
    },
    "targetSourceCondition": {
      "type": "object",
      "required": ["condition", "source-groups"],
      "properties": {
        "condition": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "source-groups": {
          "$ref": "#/definitions/nonEmptyStringArray"
        }
      },
      "additionalProperties": false
    },
    "targetSourceConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/targetSourceCondition"
      }
    },
    "sourceGroup": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "root": {
          "enum": ["package", "generated"],
          "default": "package"
        },
        "external-source": {
          "$ref": "#/definitions/packageName"
        },
        "sources": {
          "$ref": "#/definitions/nonEmptyPathArray"
        }
      },
      "additionalProperties": false
    },
    "sourceGroups": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/definitions/sourceGroup"
        }
      },
      "additionalProperties": false
    },
    "libraryTarget": {
      "type": "object",
      "required": [
        "name",
        "archive"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "archive": {
          "$ref": "#/definitions/artifactName"
        },
        "module": {
          "$ref": "#/definitions/moduleName"
        },
        "sources": {
          "$ref": "#/definitions/nonEmptyPathArray"
        },
        "source-groups": {
          "$ref": "#/definitions/nonEmptyStringArray"
        },
        "when": {
          "$ref": "#/definitions/targetSourceConditions"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/targetSources"
        }
      ],
      "additionalProperties": false
    },
    "runnableTarget": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "module": {
          "$ref": "#/definitions/moduleName"
        },
        "sources": {
          "$ref": "#/definitions/pathArray"
        },
        "source-groups": {
          "$ref": "#/definitions/nonEmptyStringArray"
        },
        "when": {
          "$ref": "#/definitions/targetSourceConditions"
        },
        "link-stdlib": {
          "type": "boolean",
          "default": true
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/targetSources"
        }
      ],
      "additionalProperties": false
    },
    "runtimeResource": {
      "type": "object",
      "required": [
        "name",
        "root",
        "path"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "root": {
          "enum": [
            "generated"
          ]
        },
        "path": {
          "$ref": "#/definitions/relativePath"
        }
      },
      "additionalProperties": false
    },
    "binaryTarget": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "module": {
          "$ref": "#/definitions/moduleName"
        },
        "sources": {
          "$ref": "#/definitions/pathArray"
        },
        "source-groups": {
          "$ref": "#/definitions/nonEmptyStringArray"
        },
        "when": {
          "$ref": "#/definitions/targetSourceConditions"
        },
        "link-stdlib": {
          "type": "boolean",
          "default": true
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/runtimeResource"
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/targetSources"
        }
      ],
      "additionalProperties": false
    },
    "testAttachment": {
      "type": "object",
      "required": ["package", "sources"],
      "properties": {
        "package": {
          "$ref": "#/definitions/packageName"
        },
        "sources": {
          "$ref": "#/definitions/nonEmptyPathArray"
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "module": {
          "$ref": "#/definitions/moduleName"
        },
        "sources": {
          "$ref": "#/definitions/pathArray"
        },
        "source-groups": {
          "$ref": "#/definitions/nonEmptyStringArray"
        },
        "when": {
          "$ref": "#/definitions/targetSourceConditions"
        },
        "link-stdlib": {
          "type": "boolean",
          "default": true
        },
        "attach": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/testAttachment"
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/targetSources"
        }
      ],
      "additionalProperties": false
    },
    "compileTestCase": {
      "type": "object",
      "required": [
        "name",
        "source",
        "outcome"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "source": {
          "$ref": "#/definitions/relativePath"
        },
        "outcome": {
          "enum": [
            "success",
            "failure"
          ]
        },
        "options": {
          "$ref": "#/definitions/stringArray"
        },
        "diagnostic-contains": {
          "$ref": "#/definitions/stringArray"
        },
        "diagnostic-contains-any": {
          "$ref": "#/definitions/stringArray"
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "enum": [
                "success"
              ]
            },
            "diagnostic-contains": {
              "allOf": [
                {
                  "$ref": "#/definitions/stringArray"
                },
                {
                  "maxItems": 0
                }
              ]
            },
            "diagnostic-contains-any": {
              "allOf": [
                {
                  "$ref": "#/definitions/stringArray"
                },
                {
                  "maxItems": 0
                }
              ]
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "failure"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "compileTest": {
      "type": "object",
      "required": [
        "cases"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/compileTestCase"
          }
        }
      },
      "additionalProperties": false
    },
    "includeDirectory": {
      "oneOf": [
        {
          "$ref": "#/definitions/relativePath"
        },
        {
          "type": "object",
          "required": ["path", "external-source"],
          "properties": {
            "path": {
              "$ref": "#/definitions/relativePath"
            },
            "external-source": {
              "$ref": "#/definitions/packageName"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["path", "root"],
          "properties": {
            "path": {
              "$ref": "#/definitions/relativePath"
            },
            "root": {
              "enum": ["package", "generated"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "includeDirectories": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/includeDirectory"
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "public-include-directories": {
          "$ref": "#/definitions/includeDirectories"
        },
        "private-include-directories": {
          "$ref": "#/definitions/includeDirectories"
        },
        "public-definitions": {
          "$ref": "#/definitions/stringArray"
        },
        "private-definitions": {
          "$ref": "#/definitions/stringArray"
        },
        "options": {
          "$ref": "#/definitions/stringArray"
        },
        "linker-options": {
          "$ref": "#/definitions/stringArray"
        },
        "threads": {
          "type": "boolean"
        },
        "system-libraries": {
          "description": "Logical operating-system or SDK library names without linker options or paths.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "conditionalConfiguration": {
      "type": "object",
      "required": ["condition", "usage"],
      "properties": {
        "condition": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "usage": {
          "$ref": "#/definitions/usage"
        }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "properties": {
        "default": {
          "type": "boolean",
          "default": false
        },
        "macro": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_-]*$": {
          "$ref": "#/definitions/feature"
        }
      },
      "additionalProperties": false
    },
    "gitUrl": {
      "description": "A non-empty Git URL without a fragment and not starting with '-'.",
      "type": "string",
      "pattern": "^[^-#][^#]*$"
    },
    "gitSelector": {
      "description": "A non-empty Git selector not starting with '-'.",
      "type": "string",
      "pattern": "^[^-]"
    },
    "gitCommit": {
      "description": "A full hexadecimal Git commit object id.",
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "archiveUrl": {
      "description": "A non-empty archive URL safe for a generated CMake project.",
      "type": "string",
      "pattern": "^[^-#\"\\\\;\\r\\n][^#\"\\\\;\\r\\n]*$"
    },
    "sha256": {
      "description": "A full hexadecimal SHA-256 digest.",
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "hostBuildToolArchive": {
      "type": "object",
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[^#\"\\\\;\\r\\n]+$"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      },
      "additionalProperties": false
    },
    "hostBuildTool": {
      "type": "object",
      "required": [
        "version",
        "executable",
        "archives"
      ],
      "properties": {
        "version": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "executable": {
          "$ref": "#/definitions/relativePath"
        },
        "archives": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z0-9]+-[A-Za-z0-9_]+$": {
              "$ref": "#/definitions/hostBuildToolArchive"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hostBuildTools": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/definitions/hostBuildTool"
        }
      },
      "additionalProperties": false
    },
    "cmakeArchiveVariant": {
      "type": "object",
      "required": [
        "archive",
        "sha256"
      ],
      "properties": {
        "archive": {
          "$ref": "#/definitions/archiveUrl"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      },
      "additionalProperties": false
    },
    "cmakeArchitectureArchives": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(?!(amd64|x64|arm64)$)[a-z0-9_-]+$": {
          "$ref": "#/definitions/cmakeArchiveVariant"
        }
      },
      "additionalProperties": false
    },
    "externalSourceRecipe": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "git": {
          "$ref": "#/definitions/gitUrl"
        },
        "branch": {
          "$ref": "#/definitions/gitSelector"
        },
        "tag": {
          "$ref": "#/definitions/gitSelector"
        },
        "rev": {
          "$ref": "#/definitions/gitSelector"
        },
        "commit": {
          "$ref": "#/definitions/gitCommit"
        },
        "archive": {
          "$ref": "#/definitions/archiveUrl"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "archives": {
          "$ref": "#/definitions/cmakeArchitectureArchives"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/gitSelectors"
        },
        {
          "oneOf": [
            {
              "required": ["path"]
            },
            {
              "required": ["git"]
            },
            {
              "required": ["archive", "sha256"]
            },
            {
              "required": ["archives"]
            }
          ]
        }
      ],
      "additionalProperties": false
    },
    "workspaceExternalSourceReference": {
      "type": "object",
      "required": ["workspace"],
      "properties": {
        "workspace": {
          "enum": [true]
        }
      },
      "additionalProperties": false
    },
    "packageExternalSource": {
      "oneOf": [
        {
          "$ref": "#/definitions/externalSourceRecipe"
        },
        {
          "$ref": "#/definitions/workspaceExternalSourceReference"
        }
      ]
    },
    "packageExternalSources": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/definitions/packageExternalSource"
        }
      },
      "additionalProperties": false
    },
    "workspaceExternalSources": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/definitions/externalSourceRecipe"
        }
      },
      "additionalProperties": false
    },
    "pkgConfigModule": {
      "description": "A non-empty pkg-config module name not starting with '-'.",
      "type": "string",
      "pattern": "^[^-].*$",
      "minLength": 1
    },
    "pkgConfigVersion": {
      "description": "One pkg-config version comparison.",
      "type": "string",
      "pattern": "^(=|<|>|<=|>=)[ \\t]*[^<>= \\t]+$"
    },
    "cmakePackage": {
      "description": "A CMake package name accepted by Lito's generated consumer project.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.+-][A-Za-z0-9_.+-]*$"
    },
    "cmakeTarget": {
      "description": "A CMake target name accepted by Lito's generated consumer project.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*$"
    },
    "cmakeCache": {
      "description": "CMake cache entries used only when building a path or Git source.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "integer"
        ]
      }
    },
    "dependencyVisibility": {
      "enum": [
        "public",
        "private",
        "link"
      ]
    },
    "gitSelectors": {
      "properties": {
        "branch": {
          "$ref": "#/definitions/gitSelector"
        },
        "tag": {
          "$ref": "#/definitions/gitSelector"
        },
        "rev": {
          "$ref": "#/definitions/gitSelector"
        },
        "commit": {
          "$ref": "#/definitions/gitCommit"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "branch",
              "tag"
            ]
          },
          {
            "required": [
              "branch",
              "rev"
            ]
          },
          {
            "required": [
              "tag",
              "rev"
            ]
          },
          {
            "required": [
              "branch",
              "commit"
            ]
          },
          {
            "required": [
              "tag",
              "commit"
            ]
          },
          {
            "required": [
              "rev",
              "commit"
            ]
          }
        ]
      }
    },
    "dependencySource": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "git": {
          "$ref": "#/definitions/gitUrl"
        },
        "branch": {
          "$ref": "#/definitions/gitSelector"
        },
        "tag": {
          "$ref": "#/definitions/gitSelector"
        },
        "rev": {
          "$ref": "#/definitions/gitSelector"
        },
        "commit": {
          "$ref": "#/definitions/gitCommit"
        },
        "visibility": {
          "$ref": "#/definitions/dependencyVisibility"
        },
        "features": {
          "$ref": "#/definitions/stringArray"
        },
        "default-features": {
          "type": "boolean",
          "default": true
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/gitSelectors"
        },
        {
          "oneOf": [
            {
              "required": [
                "path"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "git"
                    ]
                  },
                  {
                    "required": [
                      "branch"
                    ]
                  },
                  {
                    "required": [
                      "tag"
                    ]
                  },
                  {
                    "required": [
                      "rev"
                    ]
                  },
                  {
                    "required": [
                      "commit"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "git"
              ],
              "not": {
                "required": [
                  "path"
