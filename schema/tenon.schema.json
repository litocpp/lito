{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "https://raw.githubusercontent.com/litocpp/tenon/main/schema/tenon.schema.json",
  "title": "Tenon manifest",
  "description": "Structural contract for tenon.toml. Tenon remains authoritative for filesystem, workspace graph, source discovery, and toolchain-dependent validation.",
  "oneOf": [
    {
      "$ref": "#/definitions/workspaceManifest"
    },
    {
      "$ref": "#/definitions/packageManifest"
    }
  ],
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relativePath": {
      "description": "A non-empty path relative to the manifest directory. Tenon validates platform-specific path semantics.",
      "type": "string",
      "minLength": 1
    },
    "pathArray": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    },
    "nonEmptyPathArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    },
    "packageName": {
      "description": "An ASCII package name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "moduleName": {
      "description": "A dot-separated C++ module name.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "artifactName": {
      "description": "A safe artifact basename.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "packageVersion": {
      "oneOf": [
        {
          "$ref": "#/definitions/nonEmptyString"
        },
        {
          "type": "object",
          "required": [
            "workspace"
          ],
          "properties": {
            "workspace": {
              "enum": [
                true
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "predicateFamily": {
      "enum": [
        "unix",
        "windows",
        "unknown"
      ]
    },
    "predicateOs": {
      "enum": [
        "linux",
        "windows",
        "macos",
        "android",
        "freebsd",
        "netbsd",
        "openbsd",
        "unknown"
      ]
    },
    "familyPredicate": {
      "oneOf": [
        {
          "$ref": "#/definitions/predicateFamily"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/predicateFamily"
          }
        }
      ]
    },
    "osPredicate": {
      "oneOf": [
        {
          "$ref": "#/definitions/predicateOs"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/predicateOs"
          }
        }
      ]
    },
    "targetPredicate": {
      "type": "object",
      "properties": {
        "family": {
          "$ref": "#/definitions/familyPredicate"
        },
        "os": {
          "$ref": "#/definitions/osPredicate"
        },
        "not-family": {
          "$ref": "#/definitions/familyPredicate"
        },
        "not-os": {
          "$ref": "#/definitions/osPredicate"
        }
      },
      "additionalProperties": false
    },
    "sourceGroup": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "$ref": "#/definitions/nonEmptyPathArray"
        },
        "target": {
          "$ref": "#/definitions/targetPredicate"
        }
      },
      "additionalProperties": false
    },
    "sourceGroups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sourceGroup"
      }
    },
    "package": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/packageName"
        },
        "version": {
          "$ref": "#/definitions/packageVersion"
        },
        "module": {
          "$ref": "#/definitions/moduleName"
        },
        "target": {
          "$ref": "#/definitions/targetPredicate"
        }
      },
      "additionalProperties": false
    },
    "libraryPackage": {
      "allOf": [
        {
          "$ref": "#/definitions/package"
        },
        {
          "required": [
            "module"
          ]
        }
      ]
    },
    "explicitSources": {
      "anyOf": [
        {
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "$ref": "#/definitions/nonEmptyPathArray"
            }
          }
        },
        {
          "required": [
            "source-groups"
          ],
          "properties": {
            "source-groups": {
              "allOf": [
                {
                  "$ref": "#/definitions/sourceGroups"
                },
                {
                  "minItems": 1
                }
              ]
            }
          }
        }
      ]
    },
    "library": {
      "type": "object",
      "required": [
        "archive",
        "discovery"
      ],
      "properties": {
        "archive": {
          "$ref": "#/definitions/artifactName"
        },
        "discovery": {
          "enum": [
            "explicit",
            "module"
          ]
        },
        "sources": {
          "$ref": "#/definitions/pathArray"
        },
        "source-groups": {
          "$ref": "#/definitions/sourceGroups"
        }
      },
      "oneOf": [
        {
          "properties": {
            "discovery": {
              "enum": [
                "explicit"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/explicitSources"
            }
          ]
        },
        {
          "properties": {
            "discovery": {
              "enum": [
                "module"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "executable": {
      "type": "object",
      "required": [
        "name",
        "discovery"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/artifactName"
        },
        "discovery": {
          "enum": [
            "explicit",
            "module"
          ]
        },
        "sources": {
          "$ref": "#/definitions/pathArray"
        },
        "source-groups": {
          "$ref": "#/definitions/sourceGroups"
        }
      },
      "oneOf": [
        {
          "properties": {
            "discovery": {
              "enum": [
                "explicit"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/explicitSources"
            }
          ]
        },
        {
          "properties": {
            "discovery": {
              "enum": [
                "module"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "testAttachment": {
      "type": "object",
      "required": [
        "package"
      ],
      "properties": {
        "package": {
          "$ref": "#/definitions/packageName"
        },
        "sources": {
          "$ref": "#/definitions/pathArray"
        },
        "source-groups": {
          "$ref": "#/definitions/sourceGroups"
        }
      },
      "anyOf": [
        {
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "$ref": "#/definitions/nonEmptyPathArray"
            }
          }
        },
        {
          "required": [
            "source-groups"
          ],
          "properties": {
            "source-groups": {
              "allOf": [
                {
                  "$ref": "#/definitions/sourceGroups"
                },
                {
                  "minItems": 1
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": [
        "name",
        "discovery"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/artifactName"
        },
        "discovery": {
          "enum": [
            "explicit",
            "module"
          ]
        },
        "sources": {
          "$ref": "#/definitions/pathArray"
        },
        "source-groups": {
          "$ref": "#/definitions/sourceGroups"
        },
        "attach": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/testAttachment"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "discovery": {
              "enum": [
                "explicit"
              ]
            }
          },
          "allOf": [
            {
              "$ref": "#/definitions/explicitSources"
            }
          ]
        },
        {
          "properties": {
            "discovery": {
              "enum": [
                "module"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "compileTestCase": {
      "type": "object",
      "required": [
        "name",
        "source",
        "outcome"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "source": {
          "$ref": "#/definitions/relativePath"
        },
        "outcome": {
          "enum": [
            "success",
            "failure"
          ]
        },
        "options": {
          "$ref": "#/definitions/stringArray"
        },
        "diagnostic-contains": {
          "$ref": "#/definitions/stringArray"
        },
        "diagnostic-contains-any": {
          "$ref": "#/definitions/stringArray"
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "enum": [
                "success"
              ]
            },
            "diagnostic-contains": {
              "allOf": [
                {
                  "$ref": "#/definitions/stringArray"
                },
                {
                  "maxItems": 0
                }
              ]
            },
            "diagnostic-contains-any": {
              "allOf": [
                {
                  "$ref": "#/definitions/stringArray"
                },
                {
                  "maxItems": 0
                }
              ]
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "enum": [
                "failure"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "compileTest": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/compileTestCase"
          }
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "public-include-directories": {
          "$ref": "#/definitions/pathArray"
        },
        "private-include-directories": {
          "$ref": "#/definitions/pathArray"
        },
        "public-definitions": {
          "$ref": "#/definitions/stringArray"
        },
        "private-definitions": {
          "$ref": "#/definitions/stringArray"
        },
        "public-options": {
          "$ref": "#/definitions/stringArray"
        },
        "private-options": {
          "$ref": "#/definitions/stringArray"
        },
        "private-linker-options": {
          "$ref": "#/definitions/stringArray"
        }
      },
      "additionalProperties": false
    },
    "gitUrl": {
      "description": "A non-empty Git URL without a fragment and not starting with '-'.",
      "type": "string",
      "pattern": "^[^-#][^#]*$"
    },
    "gitSelector": {
      "description": "A non-empty Git selector not starting with '-'.",
      "type": "string",
      "pattern": "^[^-]"
    },
    "pkgConfigModule": {
      "description": "A non-empty pkg-config module name not starting with '-'.",
      "type": "string",
      "pattern": "^[^-].*$",
      "minLength": 1
    },
    "pkgConfigVersion": {
      "description": "One pkg-config version comparison.",
      "type": "string",
      "pattern": "^(=|<|>|<=|>=)[ \\t]*[^<>= \\t]+$"
    },
    "cmakePackage": {
      "description": "A CMake package name accepted by Tenon's generated consumer project.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.+-][A-Za-z0-9_.+-]*$"
    },
    "cmakeTarget": {
      "description": "A CMake target name accepted by Tenon's generated consumer project.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.+-]+(::[A-Za-z0-9_.+-]+)*$"
    },
    "cmakeCache": {
      "description": "CMake cache entries used only when building a path or Git source.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "integer"
        ]
      }
    },
    "dependencyVisibility": {
      "enum": [
        "public",
        "private",
        "runtime"
      ]
    },
    "gitSelectors": {
      "properties": {
        "branch": {
          "$ref": "#/definitions/gitSelector"
        },
        "tag": {
          "$ref": "#/definitions/gitSelector"
        },
        "rev": {
          "$ref": "#/definitions/gitSelector"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "branch",
              "tag"
            ]
          },
          {
            "required": [
              "branch",
              "rev"
            ]
          },
          {
            "required": [
              "tag",
              "rev"
            ]
          }
        ]
      }
    },
    "dependency": {
      "type": "object",
      "required": [
        "visibility"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "git": {
          "$ref": "#/definitions/gitUrl"
        },
        "branch": {
          "$ref": "#/definitions/gitSelector"
        },
        "tag": {
          "$ref": "#/definitions/gitSelector"
        },
        "rev": {
          "$ref": "#/definitions/gitSelector"
        },
        "visibility": {
          "$ref": "#/definitions/dependencyVisibility"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/gitSelectors"
        },
        {
          "oneOf": [
            {
              "required": [
                "path"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "git"
                    ]
                  },
                  {
                    "required": [
                      "branch"
                    ]
                  },
                  {
                    "required": [
                      "tag"
                    ]
                  },
                  {
                    "required": [
                      "rev"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "git"
              ],
              "not": {
                "required": [
                  "path"
                ]
              }
            }
          ]
        }
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_-]+$": {
          "$ref": "#/definitions/dependency"
        }
      },
      "additionalProperties": false
    },
    "pkgConfigExternalDependency": {
      "type": "object",
      "required": [
        "module",
        "visibility"
      ],
      "properties": {
        "module": {
          "$ref": "#/definitions/pkgConfigModule"
        },
        "version": {
          "$ref": "#/definitions/pkgConfigVersion"
        },
        "static": {
          "type": "boolean"
        },
        "visibility": {
          "$ref": "#/definitions/dependencyVisibility"
        }
      },
      "additionalProperties": false
    },
    "cmakeExternalTarget": {
      "type": "object",
      "required": [
        "name",
        "visibility"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/cmakeTarget"
        },
        "visibility": {
          "$ref": "#/definitions/dependencyVisibility"
        }
      },
      "additionalProperties": false
    },
    "cmakeExternalDependency": {
      "type": "object",
      "required": [
        "find-package",
        "targets"
      ],
      "properties": {
        "find-package": {
          "$ref": "#/definitions/cmakePackage"
        },
        "path": {
          "$ref": "#/definitions/relativePath"
        },
        "git": {
          "$ref": "#/definitions/gitUrl"
        },
        "branch": {
          "$ref": "#/definitions/gitSelector"
        },
        "tag": {
          "$ref": "#/definitions/gitSelector"
        },
        "rev": {
          "$ref": "#/definitions/gitSelector"
        },
        "cache": {
          "$ref": "#/definitions/cmakeCache"
        },
        "config-directory": {
          "$ref": "#/definitions/relativePath"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/cmakeExternalTarget"
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/gitSelectors"
        },
        {
          "not": {
            "required": [
              "path",
              "git"
            ]
          }
        },
        {
          "oneOf": [
            {
              "required": [
                "path"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "git"
                    ]
                  },
                  {
                    "required": [
                      "branch"
                    ]
                  },
                  {
                    "required": [
                      "tag"
                    ]
                  },
                  {
                    "required": [
                      "rev"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "git"
              ],
              "not": {
                "required": [
                  "path"
                ]
              }
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "required": [
                      "git"
                    ]
                  },
                  {
                    "required": [
                      "branch"
                    ]
                  },
                  {
                    "required": [
                      "tag"
                    ]
                  },
                  {
                    "required": [
                      "rev"
                    ]
                  },
                  {
                    "required": [
                      "cache"
                    ]
                  },
                  {
                    "required": [
                      "config-directory"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "additionalProperties": false
    },
    "externalDependencies": {
      "type": "object",
      "properties": {
        "pkg-config": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "$ref": "#/definitions/pkgConfigExternalDependency"
            }
          },
          "additionalProperties": false
        },
        "cmake": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "$ref": "#/definitions/cmakeExternalDependency"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workspacePackage": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "members"
      ],
      "properties": {
        "members": {
          "$ref": "#/definitions/nonEmptyPathArray"
        },
        "default-members": {
          "$ref": "#/definitions/nonEmptyPathArray"
        },
        "package": {
          "$ref": "#/definitions/workspacePackage"
        }
      },
      "additionalProperties": false
    },
    "workspaceManifest": {
      "type": "object",
      "required": [
        "workspace"
      ],
      "properties": {
        "workspace": {
          "$ref": "#/definitions/workspace"
        }
      },
      "additionalProperties": false
    },
    "packageManifest": {
      "type": "object",
      "required": [
        "package"
      ],
      "properties": {
        "package": {
          "$ref": "#/definitions/package"
        },
        "library": {
          "$ref": "#/definitions/library"
        },
        "executable": {
          "$ref": "#/definitions/executable"
        },
        "test": {
          "$ref": "#/definitions/test"
        },
        "compile-test": {
          "$ref": "#/definitions/compileTest"
        },
        "usage": {
          "$ref": "#/definitions/usage"
        },
        "dependencies": {
          "$ref": "#/definitions/dependencies"
        },
        "external-dependencies": {
          "$ref": "#/definitions/externalDependencies"
        }
      },
      "oneOf": [
        {
          "required": [
            "library"
          ],
          "properties": {
            "package": {
              "$ref": "#/definitions/libraryPackage"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "executable"
                ]
              },
              {
                "required": [
                  "test"
                ]
              },
              {
                "required": [
                  "compile-test"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "executable"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "library"
                ]
              },
              {
                "required": [
                  "test"
                ]
              },
              {
                "required": [
                  "compile-test"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "test"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "library"
                ]
              },
              {
                "required": [
                  "executable"
                ]
              },
              {
                "required": [
                  "compile-test"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "compile-test"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "library"
                ]
              },
              {
                "required": [
                  "executable"
                ]
              },
              {
                "required": [
                  "test"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
