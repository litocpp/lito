prefix=${pcfiledir}
includedir=${prefix}/include
libdir=${prefix}/lib

Name: tenon-fixture
Description: Controlled Tenon pkg-config fixture
Version: 2.3.4
Requires.private: tenon-private
Cflags: -I${includedir}/regular -isystem "${includedir}/system dir" -DTENON_PKG_CONFIG_FIXTURE=1
Libs: -L${libdir} -ltenon_fixture -Wl,--start-group -lrepeat -lrepeat -Wl,--end-group
